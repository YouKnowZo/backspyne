# URL of the BackSpyne API server, including its /api base path.
BACKSPYNE_API_URL=http://127.0.0.1:8080/api

# Clerk operator ID that owns this node. Keep this in the local bridge only.
BACKSPYNE_OWNER_ID=user_replace_me

# Shared with the API server's BACKSPYNE_NODE_TOKEN environment variable.
BACKSPYNE_NODE_TOKEN=replace_with_a_long_random_value

# Recommended server-side binding. Set this to the same Clerk operator ID so a
# valid token cannot submit telemetry to a different operator account.
# BACKSPYNE_NODE_OWNER_ID=user_replace_me

BACKSPYNE_NODE_ID=local-relay-01
BACKSPYNE_NODE_NAME=Local relay
BACKSPYNE_MODE=simulate
BACKSPYNE_INTERVAL_SECONDS=8
BACKSPYNE_CSI_SERIAL_PORT=
BACKSPYNE_CSI_BAUDRATE=115200
BACKSPYNE_CSI_UDP_PORT=