# API base URL, including /api. Use your public HTTPS deployment URL in production.
BACKSPYNE_API_URL=http://127.0.0.1:8080/api

# Required: real Clerk user ID of the authorized operator.
BACKSPYNE_OWNER_ID=

# Required: generate a random 32+ character secret; configure the same value as
# BACKSPYNE_NODE_TOKEN in the API environment. Do not use this sample file value.
BACKSPYNE_NODE_TOKEN=

# Set BACKSPYNE_NODE_OWNER_ID on the API to the same Clerk user ID.
BACKSPYNE_NODE_ID=local-relay-01
BACKSPYNE_NODE_NAME=Local relay
# Live scans only. Synthetic observation mode is intentionally disabled.
BACKSPYNE_MODE=live
BACKSPYNE_INTERVAL_SECONDS=8

# Optional: serial JSON-lines CSI adapter provides amplitude measurements only.
BACKSPYNE_CSI_SERIAL_PORT=
BACKSPYNE_CSI_BAUDRATE=115200

# Optional: live CSI research mode via a separate authenticated sensing engine.
# Engine must expose GET /api/v1/sensing/latest and emit real hardware source
# values (not simulated). Use localhost or HTTPS; never put this server token
# in browser code. CSI samples are accepted only while fresh and allowlisted.
BACKSPYNE_CSI_API_URL=
BACKSPYNE_CSI_API_TOKEN=
BACKSPYNE_CSI_SOURCE_ALLOWLIST=esp32,realtek_csi,mediatek_csi,qualcomm_csi
BACKSPYNE_CSI_MAX_AGE_SECONDS=10
