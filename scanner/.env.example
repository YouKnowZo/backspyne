# URL of the BackSpyne API server, including its /api base path.
BACKSPYNE_API_URL=http://127.0.0.1:8080/api

# Clerk operator ID that owns this node. Keep this in the local bridge only.
BACKSPYNE_OWNER_ID=${BACKSPYNE_OWNER_ID}

# Shared with the API server's BACKSPYNE_NODE_TOKEN environment variable.
BACKSPYNE_NODE_TOKEN=${BACKSPYNE_NODE_TOKEN}

# Recommended server-side binding. Set this to the same Clerk operator ID so a
# valid token cannot submit telemetry to a different operator account.
# BACKSPYNE_NODE_OWNER_ID=${BACKSPYNE_NODE_OWNER_ID}

BACKSPYNE_NODE_ID=${BACKSPYNE_NODE_ID:-local-relay-01}
BACKSPYNE_NODE_NAME=${BACKSPYNE_NODE_NAME:-Local relay}
# Use the computer's real WiFi/Bluetooth adapters. Set to simulate only for a
# deliberate signed connectivity test.
BACKSPYNE_MODE=${BACKSPYNE_MODE:-live}
BACKSPYNE_INTERVAL_SECONDS=${BACKSPYNE_INTERVAL_SECONDS:-8}
BACKSPYNE_CSI_SERIAL_PORT=${BACKSPYNE_CSI_SERIAL_PORT:-}
BACKSPYNE_CSI_BAUDRATE=${BACKSPYNE_CSI_BAUDRATE:-115200}
BACKSPYNE_CSI_UDP_PORT=${BACKSPYNE_CSI_UDP_PORT:-}
